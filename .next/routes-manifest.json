{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: i.ibb.co res.cloudinary.com api.qrserver.com flagcdn.com https://flagcdn.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' ws: wss: https://www.apicountries.com https://www.clarity.ms https://*.clarity.ms https://www.google-analytics.com https://*.google-analytics.com; upgrade-insecure-requests;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "http://localhost:3001/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/provider-portal/publications/[id]/change-request",
      "regex": "^/api/provider\\-portal/publications/([^/]+?)/change\\-request(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/provider\\-portal/publications/(?<nxtPid>[^/]+?)/change\\-request(?:/)?$"
    },
    {
      "page": "/api/provider-portal/submissions/[id]",
      "regex": "^/api/provider\\-portal/submissions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/provider\\-portal/submissions/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/[...path]",
      "regex": "^/api/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/prestacion/[id]",
      "regex": "^/prestacion/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/prestacion/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/prestaciones/[id]",
      "regex": "^/prestaciones/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/prestaciones/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/publicacion/[id]",
      "regex": "^/publicacion/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/publicacion/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/admin/publicaciones/nueva",
      "regex": "^/admin/publicaciones/nueva(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/publicaciones/nueva(?:/)?$"
    },
    {
      "page": "/buscar",
      "regex": "^/buscar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/buscar(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/featured-payment-launch",
      "regex": "^/featured\\-payment\\-launch(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/featured\\-payment\\-launch(?:/)?$"
    },
    {
      "page": "/featured-payment-return",
      "regex": "^/featured\\-payment\\-return(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/featured\\-payment\\-return(?:/)?$"
    },
    {
      "page": "/mi-plan",
      "regex": "^/mi\\-plan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mi\\-plan(?:/)?$"
    },
    {
      "page": "/panel-oferente",
      "regex": "^/panel\\-oferente(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/panel\\-oferente(?:/)?$"
    },
    {
      "page": "/quienes-somos",
      "regex": "^/quienes\\-somos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/quienes\\-somos(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/term-condicion",
      "regex": "^/term\\-condicion(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/term\\-condicion(?:/)?$"
    },
    {
      "page": "/tgn-panel-control",
      "regex": "^/tgn\\-panel\\-control(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tgn\\-panel\\-control(?:/)?$"
    },
    {
      "page": "/tgn-panel-control/login",
      "regex": "^/tgn\\-panel\\-control/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tgn\\-panel\\-control/login(?:/)?$"
    },
    {
      "page": "/tgn-panel-control/publicaciones/nueva",
      "regex": "^/tgn\\-panel\\-control/publicaciones/nueva(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tgn\\-panel\\-control/publicaciones/nueva(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}